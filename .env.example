# PostgreSQL connection string (get your own from neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign JWT tokens — generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secret-here"

# Port the backend server runs on
PORT=5000

# Resend API key for sending emails (get free at resend.com)
RESEND_API_KEY="your-resend-api-key"
