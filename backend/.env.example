# PostgreSQL connection string — get your own free database at https://neon.tech
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require"

# Random secret used to sign JWT tokens — generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-your-own-random-secret"

# Port the backend server runs on
PORT=5000

# Used for sending emails (e.g. registration confirmations)
EMAIL_USER="your-email@gmail.com"
EMAIL_APP_PASSWORD="your-gmail-app-password"
